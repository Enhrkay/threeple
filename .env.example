# ============================================================
# PUBLIC SUPABASE CONFIG
# Safe to expose to the browser.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key


# ============================================================
# SERVER-ONLY SUPABASE CONFIG
# NEVER expose this value with a NEXT_PUBLIC_ prefix.
# Required by lib/supabase/admin.ts.
# ============================================================

SUPABASE_SECRET_KEY=your-server-secret-key


# ============================================================
# PUBLIC APPLICATION URL
# Production example:
# APP_URL=https://threeple.example.com
#
# Used for invite links, QR codes and server-generated public URLs.
# Do not include a trailing slash.
# ============================================================

APP_URL=http://localhost:3000


# ============================================================
# SERVER-ONLY PAYSTACK CONFIG
# NEVER expose this value with a NEXT_PUBLIC_ prefix.
# Required for Paystack transaction initialization and verification.
# ============================================================

PAYSTACK_SECRET_KEY=your-paystack-secret-key
